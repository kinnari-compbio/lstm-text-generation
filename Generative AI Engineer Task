        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Input, Embedding, LSTM, Dense, Dropout\n",
        "import urllib.request\n",
        "import re\n",
        "\n",
        "# ==========================================\n",
        "# 1. DOWNLOAD AND PREPROCESS DATASET\n",
        "# ==========================================\n",
        "print(\"Step 1: Downloading dataset...\")\n",
        "url = \"https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt\"\n",
        "urllib.request.urlretrieve(url, \"shakespeare.txt\")\n",
        "\n",
        "with open(\"shakespeare.txt\", \"r\", encoding=\"utf-8\") as f:\n",
        "    # Use first 100k characters for faster training in Colab\n",
        "    raw_text = f.read()[:100000].lower()\n",
        "\n",
        "# Clean punctuation and non-alphanumeric characters\n",
        "cleaned_text = re.sub(r'[^a-z0-9\\s]', '', raw_text)\n",
        "\n",
        "# Build character mappings\n",
        "chars = sorted(list(set(cleaned_text)))\n",
        "char_to_idx = {ch: i for i, ch in enumerate(chars)}\n",
        "idx_to_char = {i: ch for i, ch in enumerate(chars)}\n",
        "vocab_size = len(chars)\n",
        "\n",
        "print(f\"Total characters: {len(cleaned_text)}\")\n",
        "print(f\"Unique characters (Vocab size): {vocab_size}\")\n",
        "\n",
        "# Create input/output sequence pairs\n",
        "seq_length = 40\n",
        "step = 3\n",
        "sequences = []\n",
        "next_chars = []\n",
        "\n",
        "for i in range(0, len(cleaned_text) - seq_length, step):\n",
        "    sequences.append([char_to_idx[c] for c in cleaned_text[i : i + seq_length]])\n",
        "    next_chars.append(char_to_idx[cleaned_text[i + seq_length]])\n",
        "\n",
        "X = np.array(sequences)\n",
        "y = tf.keras.utils.to_categorical(next_chars, num_classes=vocab_size)\n",
        "\n",
        "print(f\"Total training sequences: {len(X)}\")\n",
        "\n",
        "# ==========================================\n",
        "# 2. DEFINE AND COMPILE LSTM MODEL\n",
        "# ==========================================\n",
        "print(\"\\nStep 2: Building model...\")\n",
        "model = Sequential([\n",
        "    Input(shape=(seq_length,)),\n",
        "    Embedding(input_dim=vocab_size, output_dim=64),\n",
        "    LSTM(128, return_sequences=True),\n",
        "    Dropout(0.2),\n",
        "    LSTM(128),\n",
        "    Dropout(0.2),\n",
        "    Dense(vocab_size, activation=\"softmax\")\n",
        "])\n",
        "\n",
        "model.compile(\n",
        "    loss=\"categorical_crossentropy\",\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.002)\n",
        ")\n",
        "model.summary()\n",
        "\n",
        "# ==========================================\n",
        "# 3. TRAIN THE MODEL\n",
        "# ==========================================\n",
        "print(\"\\nStep 3: Training model...\")\n",
        "epochs = 15\n",
        "batch_size = 128\n",
        "\n",
        "history = model.fit(\n",
        "    X, y,\n",
        "    batch_size=batch_size,\n",
        "    epochs=epochs,\n",
        "    validation_split=0.1,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 4. TEXT GENERATION LOGIC\n",
        "# ==========================================\n",
        "def sample(preds, temperature=1.0):\n",
        "    preds = np.asarray(preds).astype(\"float64\")\n",
        "    preds = np.log(preds + 1e-8) / temperature\n",
        "    exp_preds = np.exp(preds)\n",
        "    preds = exp_preds / np.sum(exp_preds)\n",
        "    probas = np.random.multinomial(1, preds, 1)\n",
        "    return np.argmax(probas)\n",
        "\n",
        "def generate_text(seed_text, num_chars=200, temperature=0.5):\n",
        "    # Preprocess seed to match training data\n",
        "    seed = re.sub(r'[^a-z0-9\\s]', '', seed_text.lower())\n",
        "    if len(seed) < seq_length:\n",
        "        seed = seed.rjust(seq_length)\n",
        "    else:\n",
        "        seed = seed[-seq_length:]\n",
        "\n",
        "    generated = seed\n",
        "\n",
        "    for _ in range(num_chars):\n",
        "        token_seq = [char_to_idx.get(char, 0) for char in seed]\n",
        "        x_pred = np.array([token_seq])\n",
        "\n",
        "        preds = model.predict(x_pred, verbose=0)[0]\n",
        "        next_index = sample(preds, temperature)\n",
        "        next_char = idx_to_char[next_index]\n",
        "\n",
        "        generated += next_char\n",
        "        seed = seed[1:] + next_char\n",
        "\n",
        "    return generated\n",
        "\n",
        "# ==========================================\n",
        "# 5. GENERATE SAMPLE OUTPUTS\n",
        "# ==========================================\n",
