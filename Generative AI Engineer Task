        "    \"the king shall speak unto the people\",\n",
        "    \"first citizen before we proceed any further\"\n",
        "]\n",
        "\n",
        "for seed in seeds:\n",
        "    print(f\"\\n--- Seed: '{seed}' ---\")\n",
        "    for temp in [0.2, 0.7]:\n",
        "        print(f\"\\n[Temperature: {temp}]\")\n",
        "        output = generate_text(seed, num_chars=120, temperature=temp)\n",
